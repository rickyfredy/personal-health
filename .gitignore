# ── secrets & local config (never commit these) ──────────────────────────────
.env
.env.local
.env.*.local

# ── private medical exports (PII) — never commit ─────────────────────────────
# (exact export-file names only, so code files like ingest-healthhub.js still
#  get tracked even on case-insensitive filesystems where git matches
#  patterns case-insensitively)
/HealthHub-*.json
/HealthHub-*.csv
/HealthHub-*.html
/HealthHub-*.txt
/data/
downloads/

# ── dependencies & build output ───────────────────────────────────────────────
node_modules/
client/dist/

# ── logs & OS noise ───────────────────────────────────────────────────────────
*.log
.DS_Store
Thumbs.db
# vite config cache
client/vite.config.js.timestamp-*.mjs
